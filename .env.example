# Copy to .env and fill in secrets. .env is gitignored.
#
# --- Google "Continue with Google" (authorization code flow) ---
# In Google Cloud Console → APIs & Services → Credentials → your OAuth 2.0 Client ID:
#   Application type: Web application
#   Authorized JavaScript origins: https://khudrapasal.360winx.com
#   Authorized redirect URIs MUST include the API callback (not the SPA URL), e.g.:
#     https://khudrapasalserver.360winx.com/api/auth/social/google/callback/
#   If the API hostname differs, replace khudrapasalserver.360winx.com with your API host.
#
# When Django runs behind a reverse proxy, set OAUTH_REDIRECT_BASE to the public API origin
# so the redirect_uri matches what you registered in Google Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: path to Google Cloud "Web client" JSON ({"web":{"client_id","client_secret",...}}).
# If id/secret are empty, the API also checks ../continue_with_google.json next to the server/ folder.
# GOOGLE_OAUTH_CREDENTIALS_JSON=
OAUTH_REDIRECT_BASE=https://khudrapasalserver.360winx.com

# Where OAuth sends the browser after success (?token=…&surface=…&redirect=…)
FRONTEND_URL=https://khudrapasal.360winx.com
# Default SPA path for OAuth when `next` is omitted (align with primary_spa_redirect customer home).
# REDIRECT_AFTER_LOGIN=/portal

# CORS: SPA (FRONTEND_URL) calls the API on another host. Defaults allow all origins + explicit list.
# For stricter production: DJANGO_CORS_ALLOW_ALL=false and set CORS_ALLOWED_ORIGINS to your SPA origin(s).
# DJANGO_CORS_ALLOW_ALL=true
# CORS_ALLOWED_ORIGINS=https://khudrapasal.360winx.com,https://staging.example.com
